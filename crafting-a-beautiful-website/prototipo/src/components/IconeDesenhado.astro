---
// Os ícones dos cards no design E, com traço de desenho à mão. Cada um desenha o que o card diz, na ordem dos cards
// da Abordagem: vínculos (três pessoas amarradas por um fio, "o artesanato das relações"), clareza (o pensamento que
// se desembaraça, a clareza da TCC), reverbera (a gota e as ondas, "marcas que reverberam") e lótus (a compaixão e a
// tradição budista da Terapia Focada na Compaixão).
interface Props {
	nome: 'vinculos' | 'clareza' | 'reverbera' | 'lotus';
}

const { nome } = Astro.props;
