---
// Página de Saúde do design E: o texto dela, na ordem dela, em quatro partes ao lado de uma foto, como o "Session
// Options" do MyEverRoot, seguido do fio com os lugares que ela enumera e do fecho, também dela.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Arte from '../Arte.astro';
import BotaoWhatsapp from '../BotaoWhatsapp.astro';
import Fio from '../Fio.astro';
import { DESIGN_NOVO } from '../../data/variacoes';
import { comNegrito, paragrafos } from '../../lib/copy';

interface Props {
	pagina: CollectionEntry<'paginas'>;
	base: string;
}

const { pagina, base } = Astro.props;
const { Content } = await render(pagina);
const { titulo, partes, lugares } = pagina.data;
---

<article class="pagina-nova pagina-saude">
	<div class="dentro">
		<a class="link-discreto voltar" href={base}>Voltar para o início</a>
		<div class="quadro">
			<div class="quadro-texto">
				<h1>{titulo}</h1>
				<div class="quadro-partes">
					{
						partes.map((parte) => (
							<section class="quadro-parte" data-secao={parte.titulo}>
								<h2>{parte.titulo}</h2>
								{paragrafos(parte.texto).map((texto) => <p set:html={comNegrito(texto)} />)}
							</section>
						))
					}
				</div>
			</div>
			<div class="quadro-arte"><Arte design={DESIGN_NOVO} lugar="pagina-saude" prioridade /></div>
		</div>
		<div class="ritmo" data-secao="lugares">
			<Fio nome="ritmo" />
			<ol class="ritmo-lugares">
				{lugares.map((lugar) => <li>{lugar}</li>)}
			</ol>
		</div>
		<div class="pagina-fecho" data-secao="fecho">
			<div class="corpo"><Content /></div>
			<BotaoWhatsapp>Conversar no WhatsApp</BotaoWhatsapp>
		</div>
	</div>
</article>
