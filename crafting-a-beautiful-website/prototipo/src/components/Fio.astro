---
// Os desenhos de fio das páginas do design E. Saem do conteúdo, não são enfeite:
// "ritmo" é um fio só com um ritmo para cada lugar que ela enumera (ciclo menstrual, gestação, perimenopausa, envelhecimento);
// "encontro" são fios retos, o solo seguro, que sem se quebrarem viram fluidos, o calor e a fluidez.
interface Props {
	nome: 'ritmo' | 'encontro';
}

const { nome } = Astro.props;
