---
// Ícones de traço. A ordem segue a dos cards da Abordagem: sistêmica, TCC, trauma, compaixão.
interface Props {
	nome: 'sistema' | 'ideias' | 'marcas' | 'cuidado' | 'whatsapp';
}

const { nome } = Astro.props;
---

<svg class={`icone icone-${nome}`} viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
	{
		nome === 'sistema' && (
			<>
				<circle cx="24" cy="12" r="5.5" />
				<circle cx="11" cy="34" r="5.5" />
				<circle cx="37" cy="34" r="5.5" />
				<path d="M21 16.8 14 29.2M27 16.8l7 12.4M16.5 34h15" />
			</>
		)
	}
	{
		nome === 'ideias' && (
			<>
				<circle cx="24" cy="30" r="11" />
				<path d="M24 19v-6m0 0c0-4 3-7 8-7 0 4-3 7-8 7Zm0 0c0-3-2.5-5.5-6.5-5.5 0 3 2.5 5.5 6.5 5.5Z" />
				<path d="M19 30c1.5 2 3 3 5 3s3.5-1 5-3" />
			</>
		)
	}
	{
		nome === 'marcas' && (
			<>
				<circle cx="24" cy="24" r="3.5" />
				<path d="M16 17a10 10 0 0 0 0 14M32 17a10 10 0 0 1 0 14" />
				<path d="M10 11a18 18 0 0 0 0 26M38 11a18 18 0 0 1 0 26" />
			</>
		)
	}
	{
		nome === 'cuidado' && (
			<>
				<path d="M24 40C14 33.5 8 27.5 8 20a8 8 0 0 1 16-1.5A8 8 0 0 1 40 20c0 7.5-6 13.5-16 20Z" />
				<path d="M24 34V24m0 4c-3-.5-5-2.5-5.5-5.5 3 .5 5 2.5 5.5 5.5Zm0-2c2.5-.5 4.5-2.5 5-5-2.5.5-4.5 2.5-5 5Z" />
			</>
		)
	}
	{
		nome === 'whatsapp' && (
			<path d="M9 39l2.6-7.4A15.5 15.5 0 1 1 17.5 37ZM18.5 15.5c-1 0-2.5 1.3-2.5 3.5 0 4.5 6.5 11.5 12.5 11.5 2 0 3.5-1.6 3.5-2.6 0-.6-3-2.4-3.6-2.4-.6 0-1.4 1.6-2 1.6-1.4 0-5.3-3.9-5.3-5.3 0-.6 1.5-1.3 1.5-2s-1.7-4.3-2.6-4.3Z" />
		)
	}
</svg>
