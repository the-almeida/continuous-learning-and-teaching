---
// A imagem (ou o desenho) de cada lugar do site, por design. Fotos de banco CC0, ver IMAGENS.md.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import bordo from '../assets/fotos/folha-bordo.jpg';
import chaLivros from '../assets/fotos/cha-livros.jpg';
import chaManta from '../assets/fotos/cha-manta.jpg';
import gotas from '../assets/fotos/folha-gotas.jpg';
import lago from '../assets/fotos/lago-montanhas.jpg';
import lavanda from '../assets/fotos/lavanda-seca.jpg';
import mar from '../assets/fotos/mar-amanhecer.jpg';
import montanhas from '../assets/fotos/montanhas-amanhecer.jpg';
import poltrona from '../assets/fotos/poltrona.jpg';
import samambaia from '../assets/fotos/folha-samambaia.jpg';
import sombra from '../assets/fotos/sombra-cortina.jpg';
import aberturaNova from '../assets/fotos/design-e/abertura.jpg';
import abordagemNova from '../assets/fotos/design-e/abordagem.jpg';
import conviteNovo from '../assets/fotos/design-e/convite.jpg';
import paginaSaberes from '../assets/fotos/design-e/pagina-saberes.jpg';
import paginaSaude from '../assets/fotos/design-e/pagina-saude.jpg';
import saberesNova from '../assets/fotos/design-e/saberes-complementares.jpg';
import saudeNova from '../assets/fotos/design-e/saude-da-mulher.jpg';

type Lugar = 'abertura' | 'abordagem' | 'convite' | 'saude-da-mulher' | 'saberes-complementares' | 'pagina-saude' | 'pagina-saberes';

interface Props {
	design: string;
	lugar: Lugar;
	prioridade?: boolean;
}

const { design, lugar, prioridade = false } = Astro.props;

type Fotos = Partial<Record<Lugar, [ImageMetadata, string]>>;

// O D usa as mesmas fotos do C.
const amanhecer: Fotos = {
	abertura: [montanhas, 'Montanhas em camadas com a luz do amanhecer'],
	convite: [mar, 'Mar ao amanhecer, com o sol nascendo no horizonte'],
	'saude-da-mulher': [lago, 'Lago entre montanhas cobertas de mata e névoa'],
	'saberes-complementares': [chaManta, 'Xícara de chá sobre um livro aberto e uma manta'],
};

const fotos: Record<string, Fotos> = {
	a: {
		abertura: [samambaia, 'Folhas de samambaia sobre um fundo claro e enevoado'],
		abordagem: [gotas, 'Folha verde-acinzentada com gotas de chuva, as nervuras aparentes'],
		convite: [chaLivros, 'Livros, uma xícara de chá e uma planta perto da janela'],
		'saude-da-mulher': [bordo, 'Ramos de folhas de bordo contra a luz'],
		'saberes-complementares': [sombra, 'Sombra de plantas numa cortina clara'],
	},
	b: {
		convite: [poltrona, 'Poltrona com almofada estampada de folhas, junto a uma cortina clara'],
		'saberes-complementares': [lavanda, 'Ramo de lavanda seca sobre uma mesa branca'],
	},
	c: amanhecer,
	d: amanhecer,
	// Cada lugar do E tem o seu arquivo em assets/fotos/design-e/: para trocar a foto, basta trocar o arquivo.
	e: {
		abertura: [aberturaNova, 'Folhas de samambaia sobre um fundo claro e enevoado'],
		abordagem: [abordagemNova, 'Folha verde-acinzentada com gotas de chuva, as nervuras aparentes'],
		convite: [conviteNovo, 'Folha de palmeira, de um verde profundo, sobre um fundo escuro'],
		'saude-da-mulher': [saudeNova, 'Folhas de palmeira claras, em tons de cinza e verde'],
		'saberes-complementares': [saberesNova, 'Sombra de plantas numa cortina clara'],
		'pagina-saude': [paginaSaude, 'Folhas verde-escuras, largas e brilhantes, que preenchem a imagem'],
		'pagina-saberes': [paginaSaberes, 'Dois livros empilhados e uma planta num vaso, sobre uma mesa de madeira'],
	},
};

const foto = fotos[design]?.[lugar];
const desenho = design === 'b' && (lugar === 'abertura' || lugar === 'saude-da-mulher') ? lugar : null;
---

{
	foto && (
		<Image
			class={`arte arte-${lugar}`}
			src={foto[0]}
			alt={foto[1]}
			widths={[480, 960]}
			sizes="(min-width: 60rem) 60vw, 100vw"
			loading={prioridade ? 'eager' : 'lazy'}
			fetchpriority={prioridade ? 'high' : 'auto'}
		/>
	)
}
{
	desenho === 'abertura' && (
		<svg class="arte arte-desenho" viewBox="0 0 400 320" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2">
			<circle cx="148" cy="160" r="14" />
			<circle cx="148" cy="160" r="42" opacity=".8" />
			<circle cx="148" cy="160" r="74" opacity=".55" />
			<circle cx="148" cy="160" r="108" opacity=".3" />
			<circle cx="252" cy="160" r="14" />
			<circle cx="252" cy="160" r="42" opacity=".8" />
			<circle cx="252" cy="160" r="74" opacity=".55" />
			<circle cx="252" cy="160" r="108" opacity=".3" />
		</svg>
	)
}
{
	desenho === 'saude-da-mulher' && (
		<svg class="arte arte-desenho" viewBox="0 0 400 160" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
			<circle cx="60" cy="80" r="34" />
			<path d="M176 46a34 34 0 1 0 0 68 26 34 0 0 1 0-68Z" />
			<path d="M258 46a34 34 0 1 0 0 68 8 34 0 0 1 0-68Z" />
			<circle cx="340" cy="80" r="34" stroke-dasharray="2 6" />
		</svg>
	)
}
