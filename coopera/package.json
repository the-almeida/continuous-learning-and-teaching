{
  "name": "coopera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run services:up && next dev --turbopack",
    "services:up": "docker compose -f infra/docker-compose.yml up -d",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "services:stop": "docker compose -f infra/docker-compose.yml stop",
    "build": "next build",
    "start": "next start",
    "test": "npm run services:up && start-server-and-test \"npx next dev\" http://localhost:3000 \"jest --runInBand --verbose\"",
    "test:watch": "jest --watchAll",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "npx eslint . --max-warnings=0",
    "lint:eslint:fix": "npx eslint . --fix"
  },
  "dependencies": {
    "next": "16.2.7",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "start-server-and-test": "^2.1.5",
    "typescript": "^5",
    "typescript-eslint": "^8.60.1"
  }
}
